+"""TT micro-checkpointing proof tests. Run: python3 tests_ttmicrockpt.py"""
+import importlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import time
+from collections import defaultdict
+
+import numpy as np
+
+os.environ.pop("H668_MICRO_MAX_PAIRS", None)
