+        rname = meta.get("route")
+        n = meta.get("n") or (167 if rname == "gs" else 56)
+        route = wkm.GSRoute(n) if rname == "gs" else wkm.TTRoute(n)
+        ppath = os.path.join(d, "pools.npz")
